<Slide style={{
    width: 1280, height: 720,
    position: 'relative',
    background: '#F2F6FD',
    fontFamily: "'Microsoft YaHei', '微软雅黑', sans-serif",
    overflow: 'hidden',
}}>
    {/* A 标题块 */}
    <Box style={{ position: 'absolute', top: 30, left: 64, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Box style={{ width: 6, height: 38, background: '#1B5FD9', borderRadius: 3 }} />
        <Box>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0B2A6B', lineHeight: 1.2 }}>经营驾驶舱：一眼看清 7 家门店的家底</Text>
            <Text style={{ fontSize: 13, color: '#5A6B8C', marginTop: 4, letterSpacing: 1 }}>
                经营评分 / 转化漏斗 / 评价分析 / 星级分析 四维联动
            </Text>
        </Box>
    </Box>
    <Image src="assets/logo_2026.png" style={{
        position: 'absolute', top: 32, right: 64,
        width: 118, height: 50, objectFit: 'contain', opacity: 0.55,
    }} />

    {/* B 内容区：左截图 + 右数据 */}
    <Box style={{
        position: 'absolute', top: 118, left: 56, right: 56, height: 518,
        flexDirection: 'row', gap: 20,
    }}>
        {/* 左：真实截图 */}
        <Box style={{
            width: 706,
            background: '#FFFFFF', borderRadius: 12,
            padding: 10,
            boxShadow: '0 6px 24px rgba(11,42,107,0.12)',
            border: '1px solid rgba(27,95,217,0.12)',
        }}>
            <Image src="assets/ui_dash.png" style={{
                width: '100%', height: '100%', objectFit: 'contain', borderRadius: 8,
            }} />
        </Box>

        {/* 右：真实数据面板 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
            <Box style={{
                background: 'linear-gradient(140deg, #0B2A6B 0%, #1B5FD9 100%)',
                borderRadius: 12, padding: 18,
            }}>
                <Text style={{ fontSize: 12, color: '#8FC4F8', letterSpacing: 1, marginBottom: 4 }}>全部门店平均总分</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 8 }}>
                    <Text style={{ fontSize: 62, fontWeight: 'bold', color: '#35C8F0', lineHeight: 1.0, fontFamily: 'Arial, sans-serif' }}>62.9</Text>
                    <Text style={{ fontSize: 20, color: '#ADE8FF', marginBottom: 10 }}>分</Text>
                </Box>
                <Text style={{ fontSize: 12, color: '#B8D6F5', lineHeight: 1.5, marginTop: 6 }}>
                    累计总分 8306 分 · 最高 105 分 · 最低 0 分
                </Text>
            </Box>

            {[
                { k: '服务质量', v: '16.6', max: '20', pct: 83, color: '#35C8F0', tag: '97 家满分' },
                { k: '基础信息', v: '7.3', max: '10', pct: 73, color: '#1B5FD9', tag: '62 家满分' },
                { k: '商品货架', v: '19', max: '30', pct: 63, color: '#1B5FD9', tag: '61 家满分' },
                { k: '交易表现', v: '18.1', max: '40', pct: 45, color: '#FF8A3D', tag: '仅 21 家满分' },
            ].map((r, i) => (
                <Box key={r.k} style={{
                    background: '#FFFFFF', borderRadius: 9, padding: '11px 14px',
                    boxShadow: '0 2px 10px rgba(11,42,107,0.05)',
                }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'baseline', justifyContent: 'space-between', marginBottom: 6 }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#0B2A6B' }}>{r.k}</Text>
                        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 3 }}>
                            <Text style={{ fontSize: 19, fontWeight: 'bold', color: r.color, fontFamily: 'Arial, sans-serif' }}>{r.v}</Text>
                            <Text style={{ fontSize: 12, color: '#8494B4' }}>/{r.max}</Text>
                        </Box>
                    </Box>
                    <Box style={{ height: 6, background: '#E8EEF8', borderRadius: 3, width: '100%', position: 'relative' }}>
                        <Box style={{
                            height: 6, borderRadius: 3,
                            width: `${r.pct}%`,
                            background: r.color,
                        }} />
                    </Box>
                    <Text style={{ fontSize: 11, color: '#8494B4', marginTop: 5 }}>{r.tag}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 页脚条 */}
    <Box style={{
        position: 'absolute', left: 64, right: 64, bottom: 18,
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
    }}>
        <Text style={{ fontSize: 13, color: '#8494B4' }}>数据源：临沂爱尔眼科金水河畔店 · 美团经营参谋真实数据</Text>
        <Text style={{ fontSize: 13, color: '#8494B4', fontFamily: 'Arial, sans-serif' }}>06 / 15</Text>
    </Box>
</Slide>
